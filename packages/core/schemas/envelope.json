{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deep-agent-template/core/schemas/envelope.json",
  "title": "A2UI UiUpdate Envelope (catalog-agnostic)",
  "description": "Wire shape for NDJSON UiUpdate lines and the versioned ModelUiOutput. This schema deliberately does NOT name any component — ComponentInstance is permissive (additionalProperties: true) so the catalog can evolve without touching the envelope. The catalog.json tightens the per-component shapes.",
  "$defs": {
    "ComponentId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "ComponentInstance": {
      "type": "object",
      "required": ["id", "component"],
      "additionalProperties": true,
      "properties": {
        "id": { "$ref": "#/$defs/ComponentId" },
        "component": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/ComponentId" }
        }
      }
    },
    "UiSpec": {
      "type": "object",
      "required": ["components"],
      "additionalProperties": false,
      "properties": {
        "rootId": { "$ref": "#/$defs/ComponentId" },
        "components": {
          "type": "array",
          "items": { "$ref": "#/$defs/ComponentInstance" }
        }
      }
    },
    "UiQuestionOption": {
      "oneOf": [
        { "type": "string", "minLength": 1, "maxLength": 300 },
        {
          "type": "object",
          "required": ["label"],
          "additionalProperties": false,
          "properties": {
            "label": { "type": "string", "minLength": 1, "maxLength": 300 },
            "description": { "type": "string", "maxLength": 1000 },
            "recommended": { "type": "boolean" }
          }
        }
      ]
    },
    "UiQuestion": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id", "prompt", "kind", "options"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "prompt": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "kind": { "const": "multiple_choice" },
            "options": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4,
              "items": { "$ref": "#/$defs/UiQuestionOption" }
            }
          }
        },
        {
          "type": "object",
          "required": ["id", "prompt", "kind"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "prompt": { "type": "string", "minLength": 1, "maxLength": 1000 },
            "kind": { "const": "open_text" },
            "placeholder": { "type": "string", "maxLength": 300 }
          }
        }
      ]
    },
    "MessageUpdate": {
      "type": "object",
      "required": ["type", "text"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "message" },
        "text": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "QuestionUpdate": {
      "type": "object",
      "required": ["type", "question"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "question" },
        "question": { "$ref": "#/$defs/UiQuestion" }
      }
    },
    "UiUpdateVariant": {
      "type": "object",
      "required": ["type", "components"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "ui" },
        "rootId": { "$ref": "#/$defs/ComponentId" },
        "components": {
          "type": "array",
          "items": { "$ref": "#/$defs/ComponentInstance" }
        }
      }
    },
    "ErrorUpdate": {
      "type": "object",
      "required": ["type", "message"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "error" },
        "message": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "MainAgentActivityUpdate": {
      "type": "object",
      "required": ["type", "event"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "main_agent_activity" },
        "event": { "enum": ["started", "delta", "completed", "error"] },
        "text": { "type": "string", "maxLength": 4000 },
        "message": { "type": "string", "maxLength": 4000 }
      }
    },
    "SubagentActivityUpdate": {
      "type": "object",
      "required": ["type", "subagentName", "event"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "subagent_activity" },
        "subagentRunId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "subagentName": { "type": "string", "minLength": 1, "maxLength": 128 },
        "event": { "enum": ["started", "delta", "completed", "error"] },
        "task": { "type": "string", "maxLength": 4000 },
        "text": { "type": "string", "maxLength": 4000 },
        "message": { "type": "string", "maxLength": 4000 }
      }
    },
    "UiUpdate": {
      "oneOf": [
        { "$ref": "#/$defs/MessageUpdate" },
        { "$ref": "#/$defs/QuestionUpdate" },
        { "$ref": "#/$defs/UiUpdateVariant" },
        { "$ref": "#/$defs/ErrorUpdate" },
        { "$ref": "#/$defs/MainAgentActivityUpdate" },
        { "$ref": "#/$defs/SubagentActivityUpdate" }
      ]
    },
    "ModelUiUpdate": {
      "oneOf": [
        { "$ref": "#/$defs/MessageUpdate" },
        { "$ref": "#/$defs/QuestionUpdate" },
        { "$ref": "#/$defs/UiUpdateVariant" }
      ]
    },
    "ModelUiOutput": {
      "type": "object",
      "required": ["version", "updates"],
      "additionalProperties": false,
      "properties": {
        "version": { "const": 1 },
        "updates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/ModelUiUpdate" }
        }
      }
    }
  }
}
