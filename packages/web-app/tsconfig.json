{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "allowJs": true,
    "jsx": "preserve",
    "lib": ["dom", "dom.iterable", "es2023"],
    "module": "esnext",
    "noEmit": true,
    "plugins": [{ "name": "next" }],
    "types": ["bun", "node"]
  },
  "include": [
    "next-env.d.ts",
    "../core/src/markdown.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
