{
  "name": "@deep-agent-template/web-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "bun test",
    "test:e2e": "RUN_LIVE_E2E=1 LANGSMITH_TRACING=false bun --env-file=../../.env --env-file=.env test --parallel=1 e2e",
    "typecheck": "tsc --noEmit",
    "cli": "bun --env-file=../../.env run scripts/agent-cli.ts",
    "bin:cli": "bun run scripts/agent-cli.ts",
    "worker": "bun --env-file=../../.env run scripts/worker.ts",
    "bin:worker": "bun run scripts/worker.ts",
    "storybook": "storybook dev -p 6006 -c .storybook",
    "build-storybook": "storybook build -c .storybook"
  },
  "dependencies": {
    "@deep-agent-template/core": "workspace:*",
    "@deep-agent-template/image-gen": "workspace:*",
    "@json-render/core": "^0.4.0",
    "@json-render/react": "^0.4.0",
    "@langchain/langgraph": "^1.4.4",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "bullmq": "^5.81.2",
    "ioredis": "^5.11.1",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@storybook/addon-a11y": "^10.5.3",
    "@storybook/addon-docs": "^10.5.3",
    "@storybook/addon-onboarding": "^10.5.3",
    "@storybook/nextjs": "^10.5.3",
    "@storybook/react": "^10.5.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "storybook": "^10.5.3",
    "testcontainers": "^12.0.4",
    "typescript": "^5.9.3"
  }
}
