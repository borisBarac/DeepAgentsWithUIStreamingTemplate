{
  "name": "deep-agent-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "playwright": "1.59.1",
    "playwright-core": "1.59.1"
  },
  "scripts": {
    "check": "biome check .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "smoke:langsmith": "bun run packages/core/scripts/langsmith-smoke.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "web-app": "bun --env-file=.env run --filter @deep-agent-template/web-app dev",
    "agent-cli": "bun --env-file=.env packages/web-app/scripts/agent-cli.ts",
    "agent-cli:pipe": "bun run --filter @deep-agent-template/web-app bin:cli",
    "storybook": "bun run --filter @deep-agent-template/web-app storybook",
    "build-storybook": "bun run --filter @deep-agent-template/web-app build-storybook"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.9.0",
    "@biomejs/biome": "^2.5.0",
    "@types/bun": "^1.3.3",
    "husky": "^9.1.7",
    "typescript": "^5.9.3"
  },
  "patchedDependencies": {
    "@langchain/openai@1.4.7": "patches/@langchain%2Fopenai@1.4.7.patch"
  }
}
