{
  "name": "deep-agent-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "overrides": {
    "playwright": "1.59.1",
    "playwright-core": "1.59.1"
  },
  "scripts": {
    "check": "biome check .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "smoke:langsmith": "bun run packages/core/scripts/langsmith-smoke.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "cli": "bun run packages/cli/src/index.ts",
    "baseline": "bun run packages/cli/src/index.ts baseline",
    "scaffold": "bun run packages/cli/src/index.ts scaffold",
    "scaffold:dump": "bun run packages/cli/src/index.ts scaffold --dump"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.9.0",
    "@biomejs/biome": "^2.5.0",
    "@types/bun": "^1.3.3",
    "husky": "^9.1.7",
    "typescript": "^5.9.3"
  }
}
