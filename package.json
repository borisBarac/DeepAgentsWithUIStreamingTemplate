{
  "name": "deep-agent-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "biome check .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "smoke:langsmith": "bun run packages/core/scripts/langsmith-smoke.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.9.0",
    "@biomejs/biome": "^2.5.0",
    "@types/bun": "^1.3.3",
    "husky": "^9.1.7",
    "typescript": "^5.9.3"
  }
}
