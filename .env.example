# Linkloom MCP scraping service (streamable-HTTP).
# Local dev: points at the host port published by `docker compose up linkloom`.
# Inside Compose the worker uses LINKLOOM_MCP_URL=http://linkloom:3000/mcp instead.
LINKLOOM_MCP_URL="http://localhost:3001/mcp"
LINKLOOM_PORT="3001"

# Sandbox MCP Python execution service (streamable-HTTP).
# Local dev: points at the host port published by `docker compose up sandbox-mcp`.
SANDBOX_MCP_URL="http://localhost:3010/mcp"
SANDBOX_PORT="3010"

# Optional Linkloom tuning. Core scraping does not require an API key.
PAGE_LOAD_TIMEOUT="10000"
FRAME_TIMEOUT="5000"
PDF_DOWNLOAD_TIMEOUT="30000"
PROXY_URL=""

# The CLI uses an OpenAI-compatible endpoint such as DeepSeek, OpenAI, Ollama, or vLLM.
LLM_BASE_URL=""
LLM_API_KEY=""
LLM_MODEL="deepseek-v4-flash"

# Optional per-category model overrides. Each falls back to LLM_MODEL when unset,
# so leaving them blank runs every agent role on the same model.
#   FAST_MODEL  - cheap/low-latency tier (clarifier, guardrail classifier)
#   PRO_MODEL   - heavy-reasoning tier (supervisor, analyst, reviewer, finalizer)
# LLM_MODEL is the "normal" tier used by the remaining roles.
FAST_MODEL=""
PRO_MODEL=""

LANGSMITH_TRACING="false"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="deep-agent-template"
# Set this for non-US LangSmith regions, for example:
# LANGSMITH_ENDPOINT="https://eu.api.smith.langchain.com"
# Required only when an API key can access multiple workspaces:
# LANGSMITH_WORKSPACE_ID=""
# Use "true" for persistent processes and "false" for serverless runtimes:
LANGCHAIN_CALLBACKS_BACKGROUND="true"

# Horizontal scaling: Redis + BullMQ workers.
# Required for Redis-backed production mode. The API enqueues turns to BullMQ;
# the worker process runs each turn. Without REDIS_URL, the API and worker
# fail closed.
REDIS_URL="redis://localhost:6379"
# Namespaces this deployment's keys in a shared Redis. Default: "dat:"
REDIS_KEY_PREFIX="dat:"
# Agent activity panel + cancel-on-disconnect. Defaults ON; set to "false" to disable.
NEXT_PUBLIC_AGENT_DEBUG="true"
# BullMQ Worker concurrency (jobs in parallel per worker process).
WORKER_CONCURRENCY="5"
# Maximum queue wait before failing a job (ms).
WORKER_MAX_QUEUE_WAIT_MS="60000"

# Image designer provider used by the scaffolded agent.
# "true" (or unset) = fake/stub provider (returns a fixed image URL, no API key needed).
# "false" = real Replicate provider (requires REPLICATE_API_TOKEN).
USE_FAKE_IMAGE_PROVIDER="true"
# Required only when USE_FAKE_IMAGE_PROVIDER="false":
REPLICATE_API_TOKEN=""
