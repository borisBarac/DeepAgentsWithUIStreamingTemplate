# ============================================================================
# LinkLoom MCP
# ============================================================================
#
# LinkLoom runs as a dedicated streamable-HTTP MCP service (see
# infra/docker-compose.yml → `linkloom`). Agent workers connect over the internal
# Compose network, so no API key is required for scraping/conversion. Host
# processes use the published port below; Compose services use the internal
# http://linkloom:3000/mcp endpoint.
LINKLOOM_MCP_URL="http://localhost:3001/mcp"
LINKLOOM_PORT="3001"

# Browser tuning passed to the LinkLoom container (not the app image).
PAGE_LOAD_TIMEOUT="10000"
FRAME_TIMEOUT="5000"
PDF_DOWNLOAD_TIMEOUT="30000"
PROXY_URL=""

# The CLI uses an OpenAI-compatible endpoint such as DeepSeek, OpenAI, Ollama, or vLLM.
LLM_BASE_URL=""
LLM_API_KEY=""
LLM_MODEL="deepseek-v4-flash"

# Optional per-category model overrides. Each falls back to LLM_MODEL when unset,
# so leaving them blank runs every agent role on the same model.
#   FAST_MODEL  - cheap/low-latency tier (clarifier, guardrail classifier)
#   PRO_MODEL   - heavy-reasoning tier (supervisor, analyst, reviewer, finalizer)
# LLM_MODEL is the "normal" tier used by the remaining roles.
FAST_MODEL=""
PRO_MODEL=""

LANGSMITH_TRACING="false"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="deep-agent-template"
# Set this for non-US LangSmith regions, for example:
# LANGSMITH_ENDPOINT="https://eu.api.smith.langchain.com"
# Required only when an API key can access multiple workspaces:
# LANGSMITH_WORKSPACE_ID=""
# Use "true" for persistent processes and "false" for serverless runtimes:
LANGCHAIN_CALLBACKS_BACKGROUND="true"

# Image designer provider used by the scaffolded agent.
# "true" (or unset) = fake/stub provider (returns a fixed image URL, no API key needed).
# "false" = real Replicate provider (requires REPLICATE_API_TOKEN).
USE_FAKE_IMAGE_PROVIDER="true"
# Required only when USE_FAKE_IMAGE_PROVIDER="false":
REPLICATE_API_TOKEN=""

# ============================================================================
# Horizontal scaling (Redis + BullMQ)
# ============================================================================
#
# Required. The API always queues turns to a worker and relays its events via
# Redis Streams. This host URL matches the published Compose Redis port.
REDIS_URL="redis://localhost:6379"
# Optional key prefix to namespace this deployment's keys in a shared Redis.
REDIS_KEY_PREFIX="dat:"
# BullMQ worker concurrency (jobs processed in parallel per worker process).
WORKER_CONCURRENCY="5"
# Per-worker Docker sandbox CPU and memory budgets.
WEB_APP_SANDBOX_CPUS="2.5"
WEB_APP_SANDBOX_MEMORY="1280m"

# LinkLoom container resource limits (browser rendering is CPU/memory heavy).
LINKLOOM_CPU="1.0"
LINKLOOM_MEM="1g"
